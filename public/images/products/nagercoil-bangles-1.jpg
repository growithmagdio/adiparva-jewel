<svg width="1200" height="1500" viewBox="0 0 1200 1500" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#241008"/>
        <stop offset="45%" stop-color="#321509"/>
        <stop offset="100%" stop-color="#4A210F"/>
      </linearGradient>
      <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#D99A38"/>
        <stop offset="50%" stop-color="#C47A20"/>
        <stop offset="100%" stop-color="#E2B258"/>
      </linearGradient>
      <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
        <circle cx="20" cy="20" r="1" fill="#D99A38" fill-opacity="0.12"/>
      </pattern>
    </defs>
    <rect width="1200" height="1500" fill="url(#bgGrad)"/>
    <rect width="1200" height="1500" fill="url(#grid)"/>

    <!-- Outer Gold Frame -->
    <rect x="24" y="24" width="1152" height="1452" stroke="url(#goldGrad)" stroke-width="2" fill="none" stroke-opacity="0.4"/>
    <rect x="34" y="34" width="1132" height="1432" stroke="#D99A38" stroke-width="0.75" fill="none" stroke-opacity="0.25"/>

    <!-- Central Filigree Rosette -->
    <g transform="translate(600, 710)" stroke="url(#goldGrad)" fill="none" opacity="0.35">
      <circle r="140" stroke-width="1.5" stroke-dasharray="4 4"/>
      <circle r="100" stroke-width="1"/>
      <circle r="60" stroke-width="1.5"/>
      <circle r="20" stroke-width="2"/>
      <path d="M-160 0 H160 M0 -160 V160 M-110 -110 L110 110 M-110 110 L110 -110" stroke-width="0.75"/>
    </g>

    <!-- Content Block -->
    <g font-family="serif" text-anchor="middle">
      <text x="600" y="860" font-size="34" font-weight="500" fill="#F7EFE4" letter-spacing="1">Nagercoil Meenakari Bangles</text>
      <text x="600" y="905" font-size="14" font-family="sans-serif" font-weight="600" fill="#D99A38" letter-spacing="4">ENAMELWORK PAIR</text>
    </g>
  </svg>